# LARUbot 埋め込み用の公開ID（クライアントに露出する公開値。秘密ではないためコミット可）。
# 他のシークレット（Supabase / Stripe / Resend など）は Render の環境変数、
# またはローカルの .env.local（gitignore 対象）で設定してください。
# Render のダッシュボードで同名の変数を設定した場合はそちらが優先されます。
NEXT_PUBLIC_LARUBOT_PUBLIC_ID=501609c7-23e3-4d03-be1f-f9699dd2842e
# お問い合わせフォーム（LARUbot製）の公開フォームID
NEXT_PUBLIC_LARUBOT_FORM_ID=9dcae939-1f39-4fe8-bcdc-fae1c7a0c5a6
